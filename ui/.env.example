# Base URL of the DocQA API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public demo key (hard-quota'd); users can override with their own key in the UI
NEXT_PUBLIC_DEMO_API_KEY=
# Shows the "public demo" banner and read-only hints
NEXT_PUBLIC_DEMO_MODE=false

# Browser accounts use cookies; account builds require an empty DEMO_API_KEY.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false
