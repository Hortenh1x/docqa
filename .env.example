# --- core (required; the app refuses to start without these) ---
DATABASE_URL=postgresql+asyncpg://docqa:docqa@localhost:5433/docqa
REDIS_URL=redis://localhost:6379/0
# Sync DSN for the Celery worker; derived from DATABASE_URL when unset.
#DATABASE_URL_SYNC=postgresql+psycopg://docqa:docqa@localhost:5433/docqa

# --- embeddings ---
# stub: deterministic vectors, no network — the project works out of the box.
EMBEDDING_PROVIDER=stub              # stub | openai | ollama
EMBEDDING_DIM=1024
OPENAI_API_KEY=                      # required when EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- retrieval / query (defaults are fine; tuned against the eval set in week 4) ---
#TOP_K_VECTOR=100
#TOP_K_FTS=100
#RRF_K=60
#RERANK_TOP_N=40
#HNSW_EF_SEARCH=200
# Measured via eval/run_eval.py for the cosine gate (rerank=none) — the scale
# differs per embedding model: 0.28 for text-embedding-3-small@1024, ~0.48 for bge-m3.
REFUSAL_THRESHOLD=0.28

# --- reranking ---
RERANK_PROVIDER=none                 # cohere | local | none | stub
COHERE_API_KEY=                      # required when RERANK_PROVIDER=cohere
#COHERE_RERANK_MODEL=rerank-v3.5
# local: uv pip install sentence-transformers (bge-reranker-v2-m3, fully offline)

# --- generation ---
# stub answers deterministically without network — the project works out of the box.
LLM_PROVIDER=stub                    # openai_compat | stub
# openai_compat covers OpenAI, DeepSeek, Ollama (/v1) and vLLM via base_url.
# DeepSeek (recommended): current models are deepseek-v4-flash / deepseek-v4-pro.
# v4-flash sporadically spends completion tokens on hidden reasoning — give it room
# with LLM_MAX_TOKENS=4096, or use the legacy alias deepseek-chat (= v4-flash in
# non-thinking mode, same price; deprecated 2026-07-24 but still billing as v4-flash):
#LLM_BASE_URL=https://api.deepseek.com
#LLM_MODEL=deepseek-v4-flash
# Local Ollama:
#LLM_BASE_URL=http://localhost:11435/v1
#LLM_MODEL=<any local ollama chat model>
LLM_API_KEY=                         # required for hosted providers
#LLM_TEMPERATURE=0.1
#LLM_TIMEOUT_S=180                  # total stream deadline, including heartbeats
#LLM_MAX_TOKENS=4096                 # 1024 is plenty for answers; 4096 leaves room for
                                     # DeepSeek hidden reasoning (see LLM_MODEL note)
#CONTEXT_TOKEN_BUDGET=18000
#CONTEXT_CHUNK_MAX_TOKENS=700
# Suggested questions: when a collection's ingestion settles, the worker asks the
# LLM for starter questions (stored on the collection, shown by the UI).
#SUGGESTED_QUESTIONS_ENABLED=true
#SUGGESTED_QUESTIONS_COUNT=3

# --- rate limiting (per API key, token bucket) ---
RATE_LIMIT_ENABLED=true
#RATE_LIMIT_QUERY_PER_MINUTE=30
#RATE_LIMIT_UPLOAD_PER_MINUTE=10
#RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Legacy request counter, disabled when BUDGET_ENABLED=true. It is not a USD meter.
#RATE_LIMIT_QUERY_PER_DAY=0
# Take the client address from X-Forwarded-For — only behind a trusted proxy (Caddy).
#RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- idempotency ---
#IDEMPOTENCY_TTL_S=86400             # stored responses replay for 24h

# --- access levels ---
# Sections marked "Access: <group> only" in the documents are readable only by roles
# whose label set includes that group. Roles → labels (JSON; every role needs "all"):
#ACCESS_ROLES={"employee":["all"],"manager":["all","managers"],"hr":["all","managers","hr"],"finance":["all","managers","finance"],"leadership":["all","managers","hr","finance","leadership"]}
#ACCESS_DEFAULT_ROLE=employee        # role assumed when a query names none (least privilege)
# Demo: tell the client how many relevant passages its role could not see and which
# labels unlock them. This confirms that restricted content exists — off by default.
#ACCESS_REVEAL_HIDDEN=false

# --- limits ---
MAX_UPLOAD_MB=25                     # oversized upload -> 413
MAX_PAGES=300                        # oversized PDF -> 422

# --- misc ---
STORAGE_DIR=data/files               # uploaded files (behind StorageProtocol)
LOG_LEVEL=INFO

# --- browser accounts / private originals ---
# Local development keeps legacy service API keys until explicitly enabled.
# Production Compose defaults accounts and the USD ledger ON.
ACCOUNTS_ENABLED=false
#PUBLIC_TENANT_ID=                  # service tenant UUID; publish collections explicitly via CLI
AUTH_ALLOWED_ORIGINS=http://localhost:3002
AUTH_PUBLIC_URL=http://localhost:3002
# Google sign-in is enabled by both server credentials; SMTP is independent.
# In Google Cloud, add this exact callback to the web client's authorized redirects.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
# Secure host cookies require HTTPS in production; UI/API must be same-site.
#NEXT_PUBLIC_ACCOUNTS_ENABLED=true  # UI build flag, enabled by production overlays
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Registration is unavailable until SMTP is configured; no production mail stub.
#AUTH_SESSION_TTL_S=604800
#AUTH_VERIFY_TTL_S=86400
#AUTH_RESET_TTL_S=1800
#AUTH_ATTEMPT_WINDOW_S=900
#AUTH_ATTEMPT_ACCOUNT_LIMIT=10
#AUTH_ATTEMPT_IP_LIMIT=50
SERVICE_OPERATOR_CONTACT=dmytro.bolibok@gmail.com

# --- exact daily visitor AI allowance ---
BUDGET_ENABLED=false
BUDGET_DAILY_USD=0.50
BUDGET_IP_SECRET=                  # stable random >=32 chars; preserve across releases/backups
# Guest IP and account allowances reset at 00:00 UTC. Guest spend carries into login.
# Account + current IP limits both apply; an IP shared by several people shares its allowance.
# Every paid call reserves before HTTP; actual usage settles; unknown usage stays reserved.
# No global spending cap. Unknown model prices and unpriced Cohere visitor reranking fail closed.

# --- independent versioned originals (see deploy/durability.md) ---
STORAGE_PROVIDER=local             # local | s3; production host-loss target requires s3
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT_URL=                   # optional HTTPS S3-compatible endpoint
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket must be private, encrypted and versioned, on infrastructure independent of the API host.
# Local STORAGE_DIR becomes a disposable verified cache in s3 mode; no automatic file TTL.
